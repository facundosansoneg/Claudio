{
  "name": "farfalla-asset-property-management",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "build": "pnpm -r --if-present run build",
    "db:generate": "pnpm --filter @farfalla/database run generate",
    "db:migrate": "pnpm --filter @farfalla/database run migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
