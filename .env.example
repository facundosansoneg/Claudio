# Base de datos
DATABASE_URL=postgres://farfalla:farfalla@localhost:5432/farfalla_dev

# Auth.js (apps/web)
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Microsoft Entra ID (ver docs/adr/0002-authentication-and-authorization.md)
# Se completan cuando exista un App Registration real en Entra ID.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Login de prueba sin Azure — SOLO para desarrollo local (ver README,
# sección "Probar sin Azure"). NUNCA poner "true" en un entorno accesible
# públicamente: deja entrar sin verificar contraseña ni identidad real.
AUTH_ENABLE_DEV_LOGIN=

# Object storage compatible con S3 (ver docs/adr/0003-object-storage.md)
# Valores de ejemplo para MinIO local (docker-compose.yml)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=farfalla-documents
STORAGE_ACCESS_KEY_ID=farfalla
STORAGE_SECRET_ACCESS_KEY=farfalla12345
STORAGE_FORCE_PATH_STYLE=true
